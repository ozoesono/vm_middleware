# Postgres (host CLI uses the mapped port; containers override to postgres:5432)
DATABASE_URL=postgresql://vm_user:vm_local_pass@localhost:5435/vm_middleware
POSTGRES_USER=vm_user
POSTGRES_PASSWORD=vm_local_pass
POSTGRES_DB=vm_middleware
POSTGRES_PORT_HOST=5435

# Redis (Celery broker/backend; containers override to redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Tenable API
TENABLE_ACCESS_KEY=your-access-key
TENABLE_SECRET_KEY=your-secret-key
TENABLE_BASE_URL=https://cloud.tenable.com

# NVD (optional, speeds up CVE enrichment ~10x)
# NVD_API_KEY=your-nvd-api-key

# Jira credentials, referenced by name in config/jira.yaml (delivery defaults off)
# JIRA_API_TOKEN=your-api-token
# JIRA_USER_EMAIL=user@org.com
# Additional instances can use their own environment variable names:
# JIRA_PAYMENTS_TOKEN=your-api-token
# JIRA_PAYMENTS_EMAIL=service-account@org.com

# Pipeline
CONFIG_DIR=config
LOG_LEVEL=INFO
